<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  El paquete de nn-anime para macOS.

  El ejecutable es la aplicación entera —interfaz y migraciones van dentro—, así
  que `Contents/MacOS` no lleva nada más. Lo que sí importa:

  - `LSUIElement` **no** está, a propósito. Como no es una aplicación de Cocoa no
    tiene barra de menú ni «Salir»; el icono del Dock es la única forma de
    cerrarla (botón derecho → Salir), y marcarla como agente la quitaría. Un
    proceso sin ventana ni icono sólo se para desde el Monitor de Actividad.
  - `CFBundleVersion` lleva los cuatro números y `CFBundleShortVersionString` la
    versión tal cual: la primera es la que compara macOS y quiere dígitos.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>nn-anime</string>
  <key>CFBundleDisplayName</key>
  <string>nn-anime</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.zxuru.nn-anime</string>
  <key>CFBundleExecutable</key>
  <string>nn-anime</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleVersion</key>
  <string>__BUNDLE_VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleIconFile</key>
  <string>icon.icns</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.entertainment</string>
  <key>NSHumanReadableCopyright</key>
  <string>nn-anime</string>
</dict>
</plist>
