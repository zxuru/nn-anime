#!/bin/sh
# El lanzador del AppImage.
#
# Dentro del AppImage el directorio está montado en sólo lectura y su ruta la dice
# `$APPDIR`; si se ejecuta el AppDir sin montar —que es como se prueba—, la ruta
# es la del propio guion. Las dos formas se resuelven aquí para que el AppImage
# funcione igual de las dos maneras.
#
# No se copia el ejecutable como `AppRun` porque entonces no habría forma de saber
# dónde quedó el resto del AppDir.
#
# **Con argumentos, el servidor de consola; sin ellos, la ventana.** Es lo que
# conserva `./nn-anime.AppImage "naruto"` y `--no-open` para quien los use, sin
# quitarle a quien hace doble clic la ventana que este trabajo viene a poner.
aqui=${APPDIR:-$(dirname "$(readlink -f "$0")")}

if [ "$#" -eq 0 ]; then
  exec "$aqui/usr/bin/nn-anime-desktop"
fi

exec "$aqui/usr/bin/nn-anime" "$@"
