{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    ".": {
      "package-name": "nn-anime",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/catalog-store/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/media-proxy/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/provider-sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/providers-fixture/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/recsys/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "desktop/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "generic",
          "path": "desktop/src-tauri/Cargo.lock"
        }
      ]
    }
  }
}
