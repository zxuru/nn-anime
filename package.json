{
  "name": "nn-anime",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "hooks:instalar": "git config core.hooksPath .githooks",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "e2e": "playwright test --grep-invert 'proveedor que falla'",
    "db:migrate": "bun run packages/cli/src/db-migrate.ts",
    "db:prune": "bun run packages/cli/src/db-prune.ts",
    "e2e:install": "playwright install chromium",
    "e2e:fallo": "NN_ANIME_E2E_FALLO=search NN_ANIME_E2E_PORT=7802 playwright test failure.e2e.ts",
    "e2e:todo": "bun run e2e && bun run e2e:fallo",
    "captura": "bun run scripts/captura.ts",
    "recorte": "bun run scripts/recorte.ts",
    "package": "bun run scripts/package.ts",
    "package:unico": "bun run scripts/package/unico.ts",
    "package:smoke": "bun run scripts/package/smoke.ts",
    "desktop:check": "bun run scripts/package/desktop.ts check",
    "desktop:build": "bun run scripts/package/desktop.ts build",
    "desktop:ui": "bun build desktop/ui/actualizacion.ts --outfile desktop/ui/actualizacion.js --target browser --format esm --minify",
    "desktop:installer": "bun run scripts/package/instalador-tauri.ts",
    "version:check": "bun run scripts/version.ts check",
    "version:sync": "bun run scripts/version.ts sync",
    "version:set": "bun run scripts/version.ts set",
    "icon": "bun run scripts/icon.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@nn-anime/catalog-store": "workspace:*",
    "@nn-anime/core": "workspace:*",
    "@nn-anime/media-proxy": "workspace:*",
    "@nn-anime/provider-sdk": "workspace:*",
    "@nn-anime/providers-fixture": "workspace:*",
    "@nn-anime/server": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
