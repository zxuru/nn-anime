# Entorno de nn-anime.
#
# Todas las variables son opcionales en el uso local: sin ninguna puesta, la
# aplicación usa los directorios estándar del sistema. Este archivo existe como
# inventario —para saber qué se puede tocar— y **no lleva ningún valor real**.
# `NN_ANIME_TOKEN` es un secreto y por eso se queda vacío aquí: se pone en el
# entorno del despliegue o en un `.env` local, que está en `.gitignore`. Copiar
# a `.env` y descomentar lo que haga falta; no se sube.
#
# Bun carga `.env` solo. Para los scripts, `bun run dev` y `bun run start` lo
# heredan.

# --- Dónde vive cada cosa -------------------------------------------------
# Por defecto: $XDG_DATA_HOME/nn-anime, ~/.config/nn-anime y $XDG_CACHE_HOME/nn-anime
# en Linux y macOS; %LOCALAPPDATA%\nn-anime, %APPDATA%\nn-anime y
# %LOCALAPPDATA%\nn-anime\cache en Windows.
# NN_ANIME_DATA_DIR=
# NN_ANIME_CONFIG_DIR=
# NN_ANIME_CACHE_DIR=

# --- Interfaz y arranque --------------------------------------------------
# Idioma de la interfaz. Por defecto: el del sistema.
# NN_ANIME_LANG=

# Origen que el CLI abre en modo desarrollo. Lo pone `bun run dev`; a mano sólo
# sirve para arrancar el CLI contra otro puerto.
# NN_ANIME_DEV_ORIGIN=http://127.0.0.1:5173

# Dónde escucha Vite. Debe coincidir con el puerto del server.
# NN_ANIME_API_ORIGIN=http://127.0.0.1:7717

# --- Modo servidor (Docker, NAS, LAN) -------------------------------------
# Interfaz donde escucha. Por defecto 127.0.0.1; un contenedor usa 0.0.0.0.
# NN_ANIME_HOST=127.0.0.1
# Puerto. Por defecto 7717; la imagen usa 8080. La bandera --port gana.
# NN_ANIME_PORT=7717
# No abrir el navegador al arrancar. Acepta 1 o true.
# NN_ANIME_NO_OPEN=1
# Token fijo del servidor. Obligatorio si el host o el origen público no son
# loopback, y mínimo 16 caracteres. **No pongas un valor real en este archivo**:
# genéralo con `openssl rand -base64 32` y ponlo en el entorno del despliegue o
# en un `.env` local.
# NN_ANIME_TOKEN=
# Origen canónico del servidor, sin barra final. Fija el Host y el Origin
# admitidos; si es https, la cookie de sesión se marca Secure.
# NN_ANIME_PUBLIC_ORIGIN=https://nn.example.com
# Modo restringido: sin alta de plugins ni gestión de repositorios desde la
# interfaz, y sin reproductor mpv. Los plugins ya instalados se siguen cargando.
# NN_ANIME_LOCKED=1

# --- Recursos del arranque ------------------------------------------------
# Dónde están la interfaz construida y los `.sql` de las migraciones. La
# aplicación los resuelve sola: primero el ejecutable (donde viajan dentro) y si
# no, el árbol de fuentes. Estas dos sólo hacen falta para moverlos a mano, y se
# ignoran si la ruta no existe.
# NN_ANIME_WEB_DIR=/ruta/a/packages/web/dist
# NN_ANIME_MIGRATIONS_DIR=/ruta/a/packages/catalog-store/src/migrations

# --- Herramientas ---------------------------------------------------------
# La ruta de ffmpeg, si no está en el PATH ni junto a la aplicación. Sirve para
# remezclar un HLS a MP4. No hace falta: sin ffmpeg la conversión la hace mux.js
# dentro de la aplicación, sin instalar nada.
# NN_ANIME_FFMPEG=
# Salida de `bun run captura` y `bun run recorte`.
# NN_ANIME_CAPTURA=docs/captura.png
# NN_ANIME_CAPTURA_CLARO=docs/captura-claro.png
# NN_ANIME_RECORTE=docs/recorte.png

# Puertos del arnés de pruebas de extremo a extremo.
# NN_ANIME_E2E_PORT=7801
# NN_ANIME_E2E_MEDIA_PORT=7902

# Hace fallar la búsqueda del e2e, para probar el camino del error.
# NN_ANIME_E2E_FALLO=

# --- Riesgo: no poner esto en el arranque de verdad -----------------------
# Abre loopback y redes privadas en la lista blanca de destinos del proxy. Es la
# excepción que necesita el e2e para servir un archivo local, y **desactiva la
# mitigación de SSRF** para esas direcciones. La metadata de nube se sigue
# rechazando. El arranque lo anuncia en el registro cuando está puesta, y **se
# niega a arrancar si el host no es loopback**: en un servidor no se admite.
# NN_ANIME_ALLOW_LOOPBACK=1

# Salta la comprobación del gancho `pre-commit`. Reservado al integrador.
# NN_ANIME_INTEGRADOR=1
