{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nn-anime",
  "mainBinaryName": "nn-anime-desktop",
  "identifier": "io.github.zxuru.nn-anime",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "../../packaging/icons/icon.ico",
      "../../packaging/icons/icon.icns",
      "../../packaging/icons/icon-256.png"
