    "category": "Utility",
    "shortDescription": "nn-anime",
    "longDescription": "nn-anime: catálogo, proveedores y reproductor en una aplicación de escritorio.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "../../packaging/icons/icon-setup.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODFEMDhCNzc4NDY5MkUKUldRdWFZUjNpOUNCN1UveUNFc0pLTGRrU0NJRUE2VnkzWElVaUc0R1JOd2dYdVQ5dWVkUkhNVE0K",
      "endpoints": [
        "https://github.com/zxuru/nn-anime/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
