{
  "name": "@rona/cli",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "bin": {
    "rona": "./bin/rona"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@rona/core": "workspace:*",
