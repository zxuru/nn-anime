node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# El ejecutable y los instaladores que produce `bun run package`: se publican en
# la release, no se versionan. Y la caché de runtimes que deja Bun al compilar
# para otra plataforma.
release/
.bun-cache/

# El árbol de Rust del anfitrión de ventana (`desktop/`). Lo que compila `cargo`
# no se versiona; `Cargo.lock` **sí**, porque sin él la release no es reproducible.
# Van aquí y no en `biome.json` porque biome respeta este archivo.
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Secretos: nunca dentro del repo. `.env.example` sí, con marcadores.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.netrc
.npmrc
.pypirc
.git-credentials
serviceAccount*.json

# Credenciales de servicios
.aws/
.docker/config.json
.ssh/

# Salidas de herramientas
playwright-report/
test-results/
*.log
*.trace

# Datos locales de desarrollo: nunca dentro del repo
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
.data/

# Temporales locales del sandbox
.tmp/

# Un worktree por agente: anidado porque el sandbox de escritura se limita al
# workspace, y en .gitignore para que bun test y biome no recorran la copia
.worktrees/

# Skills de terceros instaladas en local por la herramienta: no son del
# repositorio. La skill propia, `.agents/skills/agente-worktree/`, sí se
# versiona, y el `!` la rescata del comodín anterior.
.claude/
skills-lock.json
.agents/skills/*
!.agents/skills/agente-worktree/

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
